# Required 
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
 
# Your PostgreSQL password (can be anything you choose)
POSTGRES_PASSWORD=
 
# Absolute path to your music & cover folder on your computer
# Cover folder is inside music folder
# Linux/Mac example:  /home/yourname/Music
# Windows example:    C:/Users/yourname/Music
MUSIC_DIR=
COVERS_DIR=
 
# Optional — for artist profile images 
# Get free credentials at: developer.spotify.com
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
 
# Optional — for Last.fm scrobbling 
# Get free API key at: last.fm/api
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=